# All API keys are configured PER PROFILE in the web portal (/configure) and
# stored in DATA_DIR/profiles.json — nothing secret goes in this file.
PORT=7000
DATA_DIR=./data
STALE_HOURS=24
BACKOFF_MINUTES=30
# Override the Groq model fallback chain (best first). Default:
# openai/gpt-oss-120b,openai/gpt-oss-20b
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
# Admin portal Basic Auth — portal is unprotected if either is unset
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
# Encrypts ALL stored secrets at rest (API keys, Trakt tokens, Auto-scrobble
# passwords) with AES-256-GCM. Any long random string. Existing plaintext
# secrets are encrypted on the next start. Keep it off the /data volume so a
# leaked backup can't decrypt anything, and back it up (losing it = re-enter
# keys + re-auth Trakt). SCROBBLE_KEY is still accepted as a legacy alias.
# SECRET_KEY=change-me-to-a-long-random-string
# Public hostname for install URLs & manifest logo (Cloudflare Tunnel etc.).
# Without it, links use whatever address you opened the portal from — fine on
# LAN, broken for Stremio clients outside your network.
EXTERNAL_URL=https://recs.example.com

# --- Mobile Companion app (/mobile) — passwordless OTP login ---
# Sends one-time sign-in codes over Brevo's SMTP relay (smtp-relay.brevo.com)
# via nodemailer. UNSET -> codes are logged to the server console (dev only).
# The SMTP login (username) + key (password) come from Brevo's dashboard:
# SMTP & API -> SMTP tab. The key looks like xsmtpsib-…
# BREVO_SMTP_LOGIN=9xxxxxx@smtp-brevo.com
# BREVO_SMTP_KEY=xsmtpsib-your-brevo-smtp-key
# BREVO_SMTP_HOST=smtp-relay.brevo.com   # default
# BREVO_SMTP_PORT=587                     # default; 465 = implicit TLS
# Verified Brevo sender address the codes are sent from (Brevo rejects unverified).
# MOBILE_MAIL_FROM=no-reply@example.com
# MOBILE_MAIL_FROM_NAME=AI Recommender
# Mobile session lifetime in days (default 30).
# MOBILE_SESSION_DAYS=30
# Set to 1 ONLY for bare-HTTP LAN testing — drops the Secure flag on the session
# cookie so it works without HTTPS. Leave UNSET in production (served over HTTPS).
# MOBILE_INSECURE_COOKIE=1
